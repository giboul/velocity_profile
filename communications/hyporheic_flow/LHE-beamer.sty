\mode<presentation>{
  \usetheme{Singapore}

  \ifbool{dark}{
    \definecolor{normal fg}{named}{Goldenrod}
    \definecolor{primary fg}{named}{white}
    \definecolor{secondary fg}{named}{black}
    \definecolor{tertiary fg}{named}{black}
    \definecolor{quaternary fg}{named}{black}

    \definecolor{normal bg}{named}{black}
    \definecolor{primary bg}{named}{black}
    \definecolor{secondary bg}{named}{Goldenrod}
    \definecolor{tertiary bg}{named}{Goldenrod}
    \definecolor{quaternary bg}{named}{Goldenrod}
  }{
    \definecolor{normal fg}{named}{black}
    \definecolor{primary fg}{named}{gray}
    \definecolor{secondary fg}{named}{white}
    \definecolor{tertiary fg}{named}{white}
    \definecolor{quaternary fg}{named}{white}

    \definecolor{normal bg}{named}{white}
    \definecolor{primary bg}{named}{white}
    \definecolor{secondary bg}{named}{toraval}
    \definecolor{tertiary bg}{named}{toraval}
    \definecolor{quaternary bg}{named}{toraval}
  }

  \setbeamercolor{normal text}{use=normal,fg=normal fg,bg=normal bg}

  \setbeamercolor{structure}{fg=primary bg}
  \setbeamercolor{section in head/foot}{fg=secondary bg}

  \setbeamercolor{palette primary}{use=structure,    fg=primary fg,    bg=primary bg}
  \setbeamercolor{palette secondary}{use=structure,  fg=secondary fg,  bg=secondary bg}
  \setbeamercolor{palette tertiary}{use=structure,   fg=tertiary fg,   bg=tertiary bg}
  \setbeamercolor{palette quaternary}{use=structure, fg=quaternary fg, bg=quaternary bg}

  \setbeamercolor*{titlelike}{parent=palette secondary}

  \setbeamercolor*{separation line}{}
  \setbeamercolor*{fine separation line}{}

  \setbeamercolor{caption name}{fg=normal text.fg}
  \setbeamertemplate{navigation symbols}{}

  \setbeamerfont{footnote}{size=\tiny}

  \setbeamercolor{bibliography entry author}{fg=normal fg}
  \setbeamercolor{bibliography entry title}{fg=normal fg}
  \setbeamercolor{bibliography entry location}{fg=primary fg}
  \setbeamercolor{bibliography entry note}{fg=primary fg}
}
